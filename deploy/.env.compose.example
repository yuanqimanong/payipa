# deploy/.env.compose 模板。推荐直接 `uv run pypctl init` 自动生成（各密钥独立随机）；
# 手抄本文件时复制为 deploy/.env.compose 并把全部 <generate-…> 占位换成互不相同的随机长串。
# compose 用法：docker compose -f deploy/compose.yml --env-file deploy/.env.compose up -d
#
# ⚠️ 生产必改项（preflight 开机校验，见 pyp_server/preflight.py）：
#   1. 所有密钥换成独立随机值（≥32 字节；不得沿用 dev 默认或示例值）；
#   2. PYP_SERVER_ENVIRONMENT=production（拒 dev 密钥、强制 RBAC）；
#   3. PYP_SERVER_RBAC_ENABLED=true（production 模式强制）。

# ── PostgreSQL（compose 内网服务名 db；不映射宿主端口）──────────────────────
PG_HOST=db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=<generate-pg-password>
PG_DB_PYP=pyp_sys
PG_DB_DATA_CENTER=data_center
PG_DB_BUSINESS=business

# ── 各自独立的密钥（域分离：绝不复用同一串）─────────────────────────────────
PYP_SERVER_SESSION_SECRET=<generate-48-bytes>
UPLOAD_SECRET=<generate-48-bytes>
CRED_KEK=<generate-48-bytes>
PYP_SERVER_AGENT_JOIN_TOKEN=<generate-32-bytes>

# ── 存储：容器内本地卷（compose.yml 的 pyp_data 挂 /data）───────────────────
DATA_ROOT=/data

# ── 运行环境：试用/冒烟用 dev；生产必须改 production 并开 RBAC ───────────────
PYP_SERVER_ENVIRONMENT=dev
# PYP_SERVER_RBAC_ENABLED=true
