# pyp-server self-contained image. Build context is the payipa repository root.
FROM python:3.14-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /bin/uv
WORKDIR /app

# The lockfile resolves jianbing-utils from its pinned Git tag; no sibling checkout is required.
COPY pyproject.toml uv.lock ./
COPY apps ./apps
COPY packages ./packages
RUN uv sync --frozen --no-dev --package pyp-server --no-editable

FROM python:3.14-slim
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY deploy/alembic.ini ./deploy/alembic.ini
COPY deploy/alembic ./deploy/alembic
RUN useradd --system --create-home --uid 10001 payipa \
 && mkdir -p /data \
 && chown -R payipa:payipa /data /app
USER payipa
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    DATA_ROOT=/data
ARG BUILD_COMMIT=""
ENV PYP_SERVER_BUILD_COMMIT=${BUILD_COMMIT}
EXPOSE 8000
CMD ["uvicorn", "pyp_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
