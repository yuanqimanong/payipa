# ASCII only: import-linter reads this config with the OS locale codec (GBK on Windows),
# which rejects non-ASCII bytes. Rationale for each contract is in CLAUDE.md.
[importlinter]
root_packages =
    payipa_contracts
    payipa
    pyp_server
    pyp_agent

# Layered: server -> core -> contracts (higher may import lower; lower must not import higher).
[importlinter:contract:layers]
name = payipa layered architecture (server > core > contracts)
type = layers
layers =
    pyp_server
    payipa
    payipa_contracts

# Red line: pyp-agent must not depend on payipa-core or the server (agent depends on contracts only).
[importlinter:contract:agent-min-deps]
name = pyp-agent must not depend on core or server
type = forbidden
source_modules =
    pyp_agent
forbidden_modules =
    payipa
    pyp_server

# Contracts is a dependency-free leaf: must not import any in-repo package.
[importlinter:contract:contracts-leaf]
name = payipa-contracts is a dependency-free leaf
type = forbidden
source_modules =
    payipa_contracts
forbidden_modules =
    payipa
    pyp_server
    pyp_agent

# Runtime callers must not regain a dependency on the legacy crawl facade.
[importlinter:contract:crawl-facade]
name = production code bypasses the crawl compatibility facade
type = forbidden
source_modules =
    pyp_server
    payipa.crawl.service
    payipa.crawl.sources
    payipa.crawl.batches
    payipa.crawl.nodes
    payipa.crawl.results
    payipa.crawl.resilience
    payipa.crawl.dispatch
    payipa.crawl.frontier
    payipa.crawl.schedules
forbidden_modules =
    payipa.crawl.run

# Each persistence responsibility is independently usable. Coordination belongs in service.
[importlinter:contract:crawl-responsibilities]
name = crawl persistence responsibilities remain independent
type = independence
modules =
    payipa.crawl.sources
    payipa.crawl.batches
    payipa.crawl.nodes
    payipa.crawl.dispatch
    payipa.crawl.resilience
    payipa.crawl.schedules

[importlinter:contract:crawl-policy]
name = crawl policy does not depend on persistence or application services
type = forbidden
source_modules =
    payipa.crawl._policy
forbidden_modules =
    payipa.db
    payipa.storage
    payipa.crawl.service
    payipa.crawl.ingest
    payipa.crawl.sources
    payipa.crawl.batches
    payipa.crawl.nodes
    payipa.crawl.results
    payipa.crawl.resilience
    payipa.crawl.dispatch
    payipa.crawl.frontier
    payipa.crawl.schedules

[importlinter:contract:background-transport]
name = background workers do not depend on HTTP composition
type = forbidden
source_modules =
    pyp_server.background
    pyp_server.scheduler
    pyp_server.consumer
forbidden_modules =
    pyp_server.main
    pyp_server.http
    pyp_server.lifecycle
    pyp_server.routers
