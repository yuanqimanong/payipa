# 复制为 .env 并按环境填写（.env 不入库）。启动必需项走环境变量（SDD §3.5）。

# ── PostgreSQL（三库同实例，库名可配）──────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DB_PYP=pyp_sys
PG_DB_DATA_CENTER=data_center
PG_DB_BUSINESS=business

# ── 密钥（生产务必改为随机长串；≥32 字节）────────────────────────
PYP_SERVER_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
UPLOAD_SECRET=change-me-too-please
# 凭证信封主密钥（KEK，红线9）：加密下游目标凭证/通知机器人 config；脚本/子进程永不接触
CRED_KEK=change-me-to-a-long-random-kek-at-least-32-bytes

# ── 本地对象存储（local 兜底）+ raw 保留期 ───────────────────────
DATA_ROOT=var/storage
RAW_RETENTION_DAYS=7

# ── 可选组件（M2/M5）──────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# ── M5 RBAC + SQL 窗口 ───────────────────────────────────────────
# JSON API 权限闸门（默认关；生产：pyp-admin seed-rbac + grant-role 后开启）
# PYP_SERVER_RBAC_ENABLED=true
# SQL 窗口共享只读角色（先 pyp-admin setup-sql-readonly <role> <password> 创建；
# 未配则窗口用主用户 + 恒定事务级 READ ONLY）
# PG_RO_USER=pyp_readonly
# PG_RO_PASSWORD=changeme
