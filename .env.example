# 复制为 .env 并按环境填写（.env 不入库）。启动必需项走环境变量（SDD §3.5）。

# ── PostgreSQL（三库同实例，库名可配）──────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DB_PYP=pyp_sys
PG_DB_DATA_CENTER=data_center
PG_DB_BUSINESS=business

# ── 密钥（生产务必改为随机长串；≥32 字节）────────────────────────
PYP_SERVER_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# 空库首次创建管理员必须提交的安装码（pypctl init 自动生成；建议至少 24 字节）
PYP_SERVER_BOOTSTRAP_TOKEN=change-me-to-a-random-installation-code
UPLOAD_SECRET=change-me-too-please
# 凭证信封主密钥（KEK，红线9）：加密下游目标凭证/通知机器人 config；脚本/子进程永不接触
CRED_KEK=change-me-to-a-long-random-kek-at-least-32-bytes

# ── 本地对象存储（local 兜底）+ raw 保留期 ───────────────────────
DATA_ROOT=var/storage
RAW_RETENTION_DAYS=7
# 内部上传（/internal/upload）单次请求体上限（MB，默认 64；超限 413）
# PYP_SERVER_MAX_UPLOAD_MB=64
# agent 采集响应体上限（MB，默认 10；超限按 response_too_large 处理，不解析不归档）。
# 注意：这是 **agent 进程的环境变量**——agent 不读 .env 文件，须在容器 env / systemd / shell 里设置。
# PYP_AGENT_MAX_BODY_MB=10
# PYP_AGENT_MAX_RESULT_MB=8
# PYP_AGENT_SPOOL_MB=100

# ── 未实现组件（勿配置）───────────────────────────────────────────
# REDIS_URL：未接线（队列走 PG）；配置后服务端将拒绝启动。
# S3_*：S3 后端未实现；配置任一项服务端将拒绝启动（绝不静默回退 local）。
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# ── 运行环境 / 生产安全（B 加固）──────────────────────────────────
# dev（默认，宽松：JSON API 免登录、允许上面的 dev 默认密钥）；production（严格）。
# 置 production 时启动前置校验（preflight）会拒绝：dev 默认密钥、session_secret<32B、
# RBAC 未开、安装码为默认值——把"忘配密钥就上线"变成开机即失败。
# PYP_SERVER_ENVIRONMENT=production
# 生产填写对外域名/IP，逗号分隔；默认 * 仅适合开发。
# PYP_SERVER_ALLOWED_HOSTS=pyp.example.com,10.0.0.10
# Agent 在节点管理页签发一次性入网码；production 不接受共享 join token。

# ── M5 RBAC ───────────────────────────────────────────────────────
# JSON API 权限闸门（默认关；生产：pyp-admin seed-rbac + grant-role 后开启；production 模式强制开）
# PYP_SERVER_RBAC_ENABLED=true

# ── M5 AI / LLM Gateway（凭证在库里 KEK 加密，不走 .env）─────────────
# 模型凭证经 pyp-admin/界面登记（register_model）→ config 明文用 CRED_KEK 信封加密入库。
# 本地无 key 冒烟：登记 provider=echo 的模型（无网络、回显 prompt）即可跑通整条 Gateway 链路。
