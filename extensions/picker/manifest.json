{
  "manifest_version": 3,
  "name": "payipa 点选取数",
  "version": "0.1.0",
  "description": "在目标网页上点选元素，自动生成 CSS/XPath 回填到 payipa 数据源配置页（10 定案：content script + postMessage 桥，零服务器新增面）。",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selector.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
